# Copy to .env next to your application and fill in. tdpy reads this file
# automatically; an exported variable of the same name takes precedence.
# Never commit the real .env.

# The tdjson library file, or a directory containing it.
TDJSON_PATH=/path/to/libtdjson.so

# From https://my.telegram.org/apps
TDPY_API_ID=1234567
TDPY_API_HASH=0123456789abcdef0123456789abcdef

# From @BotFather
TDPY_BOT_TOKEN=123456:ABC-DEF
